<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - CherryBox</title>
    <link rel="icon" type="image/svg+xml" href="public/cherries.svg">
    <link rel="stylesheet" href="public/css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">
    <script src="public/js/lib/axios.min.js"></script>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1>CherryBox 🍒</h1>
        </div>
        <form id="registerForm"
            style="width: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 20px;">
            <div style="width: 50%;" class="form-group">
                <label for="email">Email</label>
                <input style="width: 100%;" type="email" name="email" id="email" placeholder="email@example.com"
                    required>
            </div>
            <div style="width: 50%;" class="form-group">
                <label for="password">Contraseña</label>
                <input style="width: 100%;" type="password" name="password" id="password" placeholder="Contraseña"
                    required>
            </div>
            <div style="width: 50%;" class="form-group">
                <label for="passwordConfirm">Repetir Contraseña</label>
                <input style="width: 100%;" type="password" name="passwordConfirm" id="passwordConfirm"
                    placeholder="Contraseña" required>
            </div>
            <button class="btn btn-primary" style="width: 50%;" type="submit">Registrarse</button>
        </form>
    </div>
    <script src="public/js/auth.js"></script>
</body>

</html>