generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String           @id @default(uuid())
  email       String           @unique
  password    String
  role        Role             @default(USER)
  is_blocked  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  ownedFiles  File[]           @relation("OwnerRelation")
  permissions FilePermission[]
}

model File {
  id          String           @id @default(uuid())
  name        String
  path        String           @unique
  type        FileType
  ownerId     String?
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  owner       User?            @relation("OwnerRelation", fields: [ownerId], references: [id])
  parent      File?            @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    File[]           @relation("FolderHierarchy")
  permissions FilePermission[]
}

model FilePermission {
  id     String     @id @default(uuid())
  fileId String
  userId String
  access AccessType
  file   File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum FileType {
  FILE
  FOLDER
}

enum AccessType {
  READ
  WRITE
  DELETE
  MANAGE
}
