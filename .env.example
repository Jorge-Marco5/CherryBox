NODE_ENV=development
PORT=3000

# Configuración de base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=cherrybox_db

# Credenciales de usuario root
ADMIN_EMAIL=system_admin@example.com
ADMIN_PASSWORD=123456789

# Prisma Database URL (Local o Docker)
# Local: postgresql://postgres:postgres_password@127.0.0.1:5432/cherrybox_db?schema=public
# Docker: postgresql://postgres:postgres_password@db:5432/cherrybox_db?schema=public
DATABASE_URL="postgresql://postgres:postgres_password@127.0.0.1:5432/cherrybox_db?schema=public"

# Ruta de almacenamiento de archivos (en Docker se mapea a /app/files)
BASE_DIR=

# Autenticación y Seguridad
JWT_SECRET=super_secret_cherrybox_key_change_me
JWT_EXPIRES_IN=7d

# Configuración de Proxy Inverso
REVERSE_PROXY=false
# Solo necesario si REVERSE_PROXY=true
FRONTEND_URL=http://localhost:3000
